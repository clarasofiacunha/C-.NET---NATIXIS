@PersonalFinance.Api_HostAddress = http://localhost:5185
@budgetId = 00000000-0000-0000-0000-000000000001
@expenseCategoryId = 00000000-0000-0000-0000-000000000002
@categoryId = 00000000-0000-0000-0000-000000000003
@authCookie = replace-with-authenticated-cookie

GET {{PersonalFinance.Api_HostAddress}}/weatherforecast/
Accept: application/json

###

### Listar categorias
GET {{PersonalFinance.Api_HostAddress}}/api/categories
Cookie: .AspNetCore.Identity.Application={{authCookie}}
Accept: application/json

### Obter uma categoria
GET {{PersonalFinance.Api_HostAddress}}/api/categories/{{categoryId}}
Cookie: .AspNetCore.Identity.Application={{authCookie}}
Accept: application/json

### Criar categoria de despesa
POST {{PersonalFinance.Api_HostAddress}}/api/categories
Cookie: .AspNetCore.Identity.Application={{authCookie}}
Content-Type: application/json

{
  "name": "Alimentação",
  "type": "Expense"
}

### Atualizar categoria
PUT {{PersonalFinance.Api_HostAddress}}/api/categories/{{categoryId}}
Cookie: .AspNetCore.Identity.Application={{authCookie}}
Content-Type: application/json

{
  "name": "Transportes",
  "type": "Expense"
}

### Eliminar categoria (409 se tiver transações ou orçamentos)
DELETE {{PersonalFinance.Api_HostAddress}}/api/categories/{{categoryId}}
Cookie: .AspNetCore.Identity.Application={{authCookie}}

###

### List budgets, optionally filtered by year and month
GET {{PersonalFinance.Api_HostAddress}}/api/budgets?year=2026&month=10
Cookie: .AspNetCore.Identity.Application={{authCookie}}
Accept: application/json

### Get current budget alerts (80% near limit, over 100% exceeded)
GET {{PersonalFinance.Api_HostAddress}}/api/budgets/alerts?year=2026&month=10
Cookie: .AspNetCore.Identity.Application={{authCookie}}
Accept: application/json

### Get a budget by ID
GET {{PersonalFinance.Api_HostAddress}}/api/budgets/{{budgetId}}
Cookie: .AspNetCore.Identity.Application={{authCookie}}
Accept: application/json

### Create a monthly budget
POST {{PersonalFinance.Api_HostAddress}}/api/budgets
Cookie: .AspNetCore.Identity.Application={{authCookie}}
Content-Type: application/json

{
  "categoryId": "{{expenseCategoryId}}",
  "month": 10,
  "year": 2026,
  "limitAmount": 250.00
}

### Replace a monthly budget
PUT {{PersonalFinance.Api_HostAddress}}/api/budgets/{{budgetId}}
Cookie: .AspNetCore.Identity.Application={{authCookie}}
Content-Type: application/json

{
  "categoryId": "{{expenseCategoryId}}",
  "month": 10,
  "year": 2026,
  "limitAmount": 300.00
}

### Delete a monthly budget
DELETE {{PersonalFinance.Api_HostAddress}}/api/budgets/{{budgetId}}
Cookie: .AspNetCore.Identity.Application={{authCookie}}

### Invalid month should return 400
GET {{PersonalFinance.Api_HostAddress}}/api/budgets?month=13
Cookie: .AspNetCore.Identity.Application={{authCookie}}
Accept: application/json

### Unknown budget should return 404
GET {{PersonalFinance.Api_HostAddress}}/api/budgets/00000000-0000-0000-0000-000000000099
Cookie: .AspNetCore.Identity.Application={{authCookie}}
Accept: application/json
